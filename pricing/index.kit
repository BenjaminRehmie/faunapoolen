<!-- @include '/assets/components/_header.kit' -->
<div class="background-image">
    <img src="/assets/images/header-image-price-page.jpg" alt="Vattenlandskap med natursten och plantering" decoding="async" fetchpriority="high">
</div>

<header>

    <h1>Priser för naturpool, koidamm, fontän och vattenfall</h1>
    <p>Här ser du ungefärliga startpriser för naturpool, koidamm, fontän, vattenfall och regnvatteninsamling. Varje projekt anpassas efter plats, material och ambitionsnivå.</p>
</header>
<div id="recreation-ponds" class="anchor"></div>

<section>
    <div class="grid-row align-center section-content grid-bp-reverse">
        <div class="grid-cell">

            <h2>Naturpooler</h2>
            <p>Fördjupa dig i kristallklart vatten, fritt från kemikalier, där natur och lyx möts i perfekt harmoni.</p>
            <ul class="mt-1">
                <li><span class="material-symbols-outlined">check_small</span><span>Minst 3,5 m x 5 m damm</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Handplockad natursten</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>EPDM-dammduk och underlag</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Kaskadvattenfall</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Aquascapes naturliga filtreringssystem</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Belysning, vattenväxter och anlagd trädgård</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Smart Pond XT-doseringssystem</span></li>
            </ul>
            <div class="text-small mt-1">Serier</div>
            <div class="pricing-series-links">
                <a href="/plunge-series.html"><span>Plunge-serien</span><span class="material-symbols-outlined">arrow_forward</span></a>
                <a href="/swim-series.html"><span>Swim-serien</span><span class="material-symbols-outlined">arrow_forward</span></a>
                <a href="/waterfront-series.html"><span>Waterfront-serien</span><span class="material-symbols-outlined">arrow_forward</span></a>
            </div>
            <h4 class="mt-2 mb-0">Från 1 799 750 kr</h4>
            <span class="text-discreet text-small">plus moms &amp; frakt</span>
        </div>
        <div class="grid-cell ">
            <img src="/assets/images/pricing-nature-pool.jpg" alt="Naturpool med biologisk filtrering" class="section-image" loading="lazy" decoding="async" />
        </div>
    </div>
</section>
<div id="fountains" class="anchor"></div>

<section>
    <div class="grid-row align-center section-content">
        <div class="grid-cell ">
            <img src="/assets/images/pricing-fountains.jpg" alt="Dekorativ fontän för trädgård" class="section-image" loading="lazy" decoding="async" />
        </div>
        <div class="grid-cell">

            <h2>Fontäner</h2>
            <p>Det stillsamma ljudet av vatten förhöjer atmosfären, minskar stress och skapar en tidlös fokuspunkt i din trädgård. Det finns många olika fontänstilar att välja mellan.</p>
            <ul class="mt-1">
                <li><span class="material-symbols-outlined">check_small</span><span>AquaBasin 45</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Ultra 8000-vattenpump</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Dekorativ flodsten</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Anpassat till din omgivning</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Beräknad byggtid: 1 dag</span></li>
            </ul>
            <h4 class="mt-2 mb-0">Från 169 000 kr</h4>
            <span class="text-discreet text-small">plus moms &amp; frakt</span>
        </div>
    </div>
</section>
<div id="koi-pond" class="anchor"></div>

<section>
    <div class="grid-row align-center section-content grid-bp-reverse">
        <div class="grid-cell">

            <h2>Koidammar</h2>
            <p>Se hur färgstarka koi glider genom kristallklart vatten och skapar en känsla av lugn och naturlig skönhet i din trädgård.</p>
            <ul class="mt-1">
                <li><span class="material-symbols-outlined">check_small</span><span>Minst 2 m x 1,5 m damm</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>EPDM-dammduk och underlag</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Signature Series 400-dammskimmer med konstgjort stenlock</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Aquascape BioFalls® filtreringssystem</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Belysning, vattenväxter och anlagd trädgård</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>EcoWave 8000-dammpump</span></li>
            </ul>
            <div class="text-small mt-1">Serier</div>
            <div class="pricing-series-links">
                <a href="/koi-pond-series.html"><span>Koi-serien</span><span class="material-symbols-outlined">arrow_forward</span></a>
            </div>
            <h4 class="mt-2 mb-0">Från 294 750 kr</h4>
            <span class="text-discreet text-small">plus moms &amp; frakt</span>
        </div>
        <div class="grid-cell ">
            <img src="/assets/images/pricing-koi-ponds.jpg" alt="Koidamm med natursten och vattenväxter" class="section-image" loading="lazy" decoding="async" />
        </div>
    </div>
</section>
<div id="waterfall" class="anchor"></div>

<section>
    <div class="grid-row align-center section-content">
        <div class="grid-cell ">
            <img src="/assets/images/waterfall.jpg" alt="Vattenfall byggt med natursten" class="section-image" loading="lazy" decoding="async" />
        </div>
        <div class="grid-cell">

            <h2>Vattenfall</h2>
            <p>Låt en mjuk kaskad av vatten dämpa stressen och bjuda in lugn i vardagen.</p>
            <ul class="mt-1">
                <li><span class="material-symbols-outlined">check_small</span><span>Spillway för vattenfall</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>EPDM-strömduk och underlag</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Ultra 8000-vattenpump</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Minst 2 m bäck</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>AquaBlox våtmarksfiltreringssystem</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Dolt vattenfallvalv</span></li>
            </ul>
            <h4 class="mt-2 mb-0">Från 294 000 kr</h4>
            <span class="text-discreet text-small">plus moms &amp; frakt</span>
        </div>
    </div>
</section>
<div id="water-storage" class="anchor"></div>

<section>
    <div class="grid-row align-center section-content grid-bp-reverse">
        <div class="grid-cell">

            <h2>Regnvatteninsamling</h2>
            <p>Lösningen passar för återanvändning av vatten till trädgårdsbevattning, biltvätt eller toaletter, vilket minskar användningen av kommunalt vatten och främjar en mer hållbar livsstil.</p>
            <ul class="mt-1">
                <li><span class="material-symbols-outlined">check_small</span><span>Ränngångsfilter</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>EPDM-liner</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>AquaBlox våtmarksfiltreringssystem</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>EcoWave 8000-vattenpump</span></li>
            </ul>
            <h4 class="mt-2 mb-0">Från 399 000 kr</h4>
            <span class="text-discreet text-small">plus moms &amp; frakt</span>
        </div>
        <div class="grid-cell ">
            <img src="/assets/images/pricing-water-storage.jpg" alt="Regnvatteninsamling och vattenlagring" class="section-image" loading="lazy" decoding="async" />
        </div>
    </div>
</section>
<div id="maintenance" class="anchor"></div>

<section>
    <div class="grid-row align-center section-content">
        <div class="grid-cell ">
            <img src="/assets/images/pricing-landscape.jpg" alt="Trädgårdsskötsel och underhåll" class="section-image" loading="lazy" decoding="async" />
        </div>
        <div class="grid-cell">

            <h2>Trädgårdsskötsel och underhåll</h2>
            <p>Vi erbjuder landskaps- och trädgårdstjänster med fokus på kvalitet, god service och nöjda kunder.</p>
            <ul class="mt-1">
                <li><span class="material-symbols-outlined">check_small</span><span>Landskapsdesign</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Steninfarter och gångstigar</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Växter och natursten</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Grillplatser och eldstäder</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Pool- och dammunderhåll samt reparationer</span></li>
                <li><span class="material-symbols-outlined">check_small</span><span>Trädgårdsskötsel</span></li>
            </ul>
            <h4 class="mt-2 mb-0"><a href="/contact/">Kontakta oss för en offert</a></h4>
        </div>
    </div>
</section>
